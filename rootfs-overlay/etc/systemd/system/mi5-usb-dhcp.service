[Unit]
Description=Mi 5 USB management address assignment
After=mi5-usb-gadget.service
Requires=mi5-usb-gadget.service
PartOf=mi5-usb-gadget.service

[Service]
Type=simple
User=mi5-usb
Group=mi5-usb
RuntimeDirectory=mi5-usb-dhcp
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/run/mi5-usb/dnsmasq.conf --pid-file= --user=mi5-usb --group=mi5-usb
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX AF_PACKET

[Install]
WantedBy=multi-user.target
